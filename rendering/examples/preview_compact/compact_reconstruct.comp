#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=8,local_size_y=8) in;
layout(constant_id=69) const uint PR_SPATIAL_MEAN_ABI=1u;
layout(constant_id=80) const uint PR_PREVIEW_SPARSE_COMPUTE_ABI=1u;
layout(constant_id=83) const uint PROFILE_MARKER=1u;
layout(constant_id=88) const uint PR_PREVIEW_COMPACT_COMPUTE_ABI=1u;
layout(set=0,binding=0,rgba32f) readonly uniform image2D currentLinear;
layout(set=0,binding=1,rgba32f) writeonly uniform image2D meanLinear;
layout(set=0,binding=2,rgba8) writeonly uniform image2D displayColor;
layout(set=0,binding=3,std430) buffer Status {
    uint invalid; uint visible; uint anchors; uint reconstructed;
    uint fallback; uint nondiffuse; uint acceptedNeighbors; uint primaryProposals;
} status;
layout(set=0,binding=4) uniform sampler2D incomingGuide;
layout(set=0,binding=5) uniform sampler2D forwardDepth;
layout(set=0,binding=6) uniform usampler2D instanceIds;
layout(set=0,binding=7) uniform usampler2D coverage;
layout(set=0,binding=8) uniform sampler2D fullAttributes;
layout(set=0,binding=9) uniform sampler2D guideDepth;
layout(set=0,binding=10) uniform usampler2D guideIds;
layout(set=0,binding=11) uniform usampler2D guideCoverage;
layout(push_constant) uniform Push { uint width,height,batch,mode; float exposure; } p;
#include "resident_display.glsl"
bool finiteRadiance(vec3 x) {return !any(isnan(x))&&!any(isinf(x))&&!any(lessThan(x,vec3(0.0)));}
bool finiteCode(float x,float maximum) {return !isnan(x)&&!isinf(x)&&x>=0.0&&x<=maximum&&floor(x)==x;}
vec3 decodeNormal(uint code) {
    vec2 v=vec2(code&1023u,(code>>10u)&1023u)*(2.0/1023.0)-vec2(1.0);
    vec3 n=vec3(v,1.0-abs(v.x)-abs(v.y));
    if(n.z<0.0)n.xy=(vec2(1.0)-abs(n.yx))*mix(vec2(-1.0),vec2(1.0),greaterThanEqual(n.xy,vec2(0.0)));
    return normalize(n);
}
bool finiteDepth(float z) {return !isnan(z)&&!isinf(z)&&z>0.0;}
bool depthMatches(float a,float b) {return finiteDepth(a)&&finiteDepth(b)&&abs(a-b)<=.003*min(a,b);}
void main() {
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy),extent=ivec2(p.width,p.height);
    if(any(greaterThanEqual(pixel,extent)))return;
    vec4 primary=imageLoad(currentLinear,pixel);
    if(PR_SPATIAL_MEAN_ABI!=1u||PR_PREVIEW_SPARSE_COMPUTE_ABI!=1u||PROFILE_MARKER!=1u||
       PR_PREVIEW_COMPACT_COMPUTE_ABI!=1u||p.batch!=0u||!finiteRadiance(primary.rgb)) {
        atomicOr(status.invalid,1u);return;
    }
    // Count low raster hits once, independently of full-rate coverage parity.
    if(all(equal(pixel%4,ivec2(2)))) {
        ivec2 cell=pixel/4;
        vec4 hit=texelFetch(incomingGuide,cell,0);
        if(texelFetch(guideCoverage,cell,0).r!=0u&&texelFetch(guideIds,cell,0).r!=0u) {
            if(!finiteRadiance(hit.rgb)||!finiteCode(hit.a,16777215.0)){atomicOr(status.invalid,2u);return;}
            if((uint(hit.a)&(1u<<20u))!=0u) {
                atomicAdd(status.anchors,1u);atomicAdd(status.primaryProposals,uint(PR_PREVIEW_PATHS));
            }
        }
    }
    vec3 linear=primary.rgb;
    uint id=texelFetch(instanceIds,pixel,0).r;
    if(id!=0u&&texelFetch(coverage,pixel,0).r!=0u) {
        atomicAdd(status.visible,1u);
        if(!finiteCode(primary.a,16777215.0)){atomicOr(status.invalid,4u);return;}
        uint code=uint(primary.a);
        vec3 rho=vec3(code&255u,(code>>8u)&255u,(code>>16u)&255u)*(1.0/255.0);
        if(any(greaterThan(rho,vec3(0.0)))) {
            vec4 own=texelFetch(fullAttributes,pixel,0);
            float z=texelFetch(forwardDepth,pixel,0).r;
            if(!finiteRadiance(own.rgb)||!finiteCode(own.a,1048575.0)||!finiteDepth(z)) {
                atomicOr(status.invalid,8u);return;
            }
            vec3 normal=decodeNormal(uint(own.a));
            ivec2 base=ivec2(floor((vec2(pixel)-vec2(2.0))*.25+vec2(.5)))-ivec2(2);
            ivec2 first=max(base,ivec2(0));
            ivec2 last=min(base+ivec2(4),(extent+ivec2(3))/4-ivec2(1));
            vec3 sum=vec3(0.0);float weightSum=0.0;uint accepted=0u;
            for(int y=first.y;y<=last.y;++y)for(int x=first.x;x<=last.x;++x) {
                ivec2 cell=ivec2(x,y),anchor=cell*4+ivec2(2);
                if(any(greaterThanEqual(anchor,extent)))continue; // no endpoint clamping
                if(texelFetch(guideCoverage,cell,0).r==0u||texelFetch(guideIds,cell,0).r!=id)continue;
                // Reject different rasterized identities at the intended full
                // sample, then enforce the same bounded depth/normal support.
                if(texelFetch(coverage,anchor,0).r==0u||texelFetch(instanceIds,anchor,0).r!=id)continue;
                vec4 candidate=texelFetch(incomingGuide,cell,0);
                vec4 anchorAttributes=texelFetch(fullAttributes,anchor,0);
                float lowZ=texelFetch(guideDepth,cell,0).r,fullZ=texelFetch(forwardDepth,anchor,0).r;
                if(!finiteRadiance(candidate.rgb)||!finiteCode(candidate.a,16777215.0)||!finiteCode(anchorAttributes.a,1048575.0)) {
                    atomicOr(status.invalid,16u);continue;
                }
                uint candidateCode=uint(candidate.a);
                if((candidateCode&(1u<<20u))==0u)continue;
                vec3 candidateN=decodeNormal(candidateCode);
                if(!depthMatches(lowZ,fullZ)||dot(candidateN,decodeNormal(uint(anchorAttributes.a)))<.98)continue;
                if(!depthMatches(z,lowZ)||dot(normal,candidateN)<.98)continue;
                vec2 distance=vec2(anchor-pixel)*.25;
                float weight=exp(-dot(distance,distance)/(2.0*1.5*1.5))*(1.0/32.0);
                sum+=candidate.rgb*weight;weightSum+=weight;++accepted;
            }
            vec3 incoming=own.rgb;
            if(weightSum>0.0) {
                incoming=sum/weightSum;atomicAdd(status.reconstructed,1u);
                atomicAdd(status.acceptedNeighbors,accepted);
            } else atomicAdd(status.fallback,1u);
            linear+=rho*incoming;
        } else atomicAdd(status.nondiffuse,1u);
    }
    if(!finiteRadiance(linear)){atomicOr(status.invalid,32u);return;}
    imageStore(meanLinear,pixel,vec4(linear,1.0));
    vec3 mapped=residentDisplayLinear(linear*p.exposure,float(p.mode));
    if(!finiteRadiance(mapped)){atomicOr(status.invalid,64u);return;}
    vec3 color=clamp(mapped,0.0,1.0);
    color=mix(12.92*color,1.055*pow(color,vec3(1.0/2.4))-.055,greaterThan(color,vec3(.0031308)));
    imageStore(displayColor,pixel,vec4(color,1.0));
}
