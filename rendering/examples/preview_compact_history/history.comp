#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=8,local_size_y=8) in;
layout(constant_id=93) const uint PR_PREVIEW_COMPACT_HISTORY_ABI=1u;
layout(set=0,binding=0,rgba32f) readonly uniform image2D primary;
layout(set=0,binding=1,rgba32f) writeonly uniform image2D resolvedLinear;
layout(set=0,binding=2,rgba8) writeonly uniform image2D displayColor;
layout(set=0,binding=3,std430) buffer Status {
    uint invalid,visible,anchors,reconstructed,fallback,nondiffuse,neighbors,proposals;
    uint eligible,accepted,rejectedProjection,rejectedGeometry,rejectedSupport,clamped,ageSum,resetPixels;
} status;
layout(set=0,binding=5) uniform sampler2D forwardDepth;
layout(set=0,binding=6) uniform usampler2D instanceIds;
layout(set=0,binding=7) uniform usampler2D coverage;
layout(set=0,binding=8) uniform sampler2D attributes;
layout(set=0,binding=12,std430) readonly buffer Current {vec4 incoming[];} now;
struct HistoryPixel {vec4 incomingAge;uvec4 geometry;};
layout(set=0,binding=13,std430) readonly buffer Previous {HistoryPixel pixels[];} previous;
layout(set=0,binding=14,std430) writeonly buffer Next {HistoryPixel pixels[];} nextHistory;
layout(set=0,binding=15,std140) uniform HistoryCamera {
    mat4 view,previousView;
    vec4 intrinsics,previousIntrinsics;
    uvec4 controls; // width,height,has-committed-history,age cap
} h;
layout(push_constant) uniform Push {uint width,height,batch,mode;float exposure;} p;
#include "resident_display.glsl"

bool finite3(vec3 v) {return !any(isnan(v))&&!any(isinf(v))&&!any(lessThan(v,vec3(0.0)));}
bool depthMatches(float a,float b) {
    return !isnan(a)&&!isinf(a)&&!isnan(b)&&!isinf(b)&&min(a,b)>0.0&&abs(a-b)<=.003*min(a,b);
}
vec3 normalFrom(uint code) {
    vec2 v=vec2(code&1023u,(code>>10u)&1023u)*(2.0/1023.0)-1.0;
    vec3 n=vec3(v,1.0-abs(v.x)-abs(v.y));
    if(n.z<0.0)n.xy=(1.0-abs(n.yx))*mix(vec2(-1.0),vec2(1.0),greaterThanEqual(n.xy,vec2(0.0)));
    return normalize(n);
}
vec3 worldPoint(vec2 pixel,float z,mat4 view,vec4 k) {
    vec3 camera=vec3((pixel.x-k.z)*z/k.x,-(pixel.y-k.w)*z/k.y,-z);
    return transpose(mat3(view))*(camera-view[3].xyz);
}
vec3 projectPoint(vec3 world,mat4 view,vec4 k) {
    vec3 c=(view*vec4(world,1.0)).xyz;float z=-c.z;
    return vec3(k.x*c.x/z+k.z,-k.y*c.y/z+k.w,z);
}
void main() {
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy),extent=ivec2(p.width,p.height);
    if(any(greaterThanEqual(pixel,extent)))return;
    uint index=uint(pixel.y)*p.width+uint(pixel.x);
    vec4 current=now.incoming[index],base=imageLoad(primary,pixel);
    vec3 filtered=current.rgb;float age=0.0;
    uint id=texelFetch(instanceIds,pixel,0).r;
    float z=texelFetch(forwardDepth,pixel,0).r;
    uint code=uint(texelFetch(attributes,pixel,0).a);
    bool supported=current.a==1.0&&id!=0u&&texelFetch(coverage,pixel,0).r!=0u;
    if(PR_PREVIEW_COMPACT_HISTORY_ABI!=1u||any(notEqual(h.controls.xy,uvec2(p.width,p.height)))||!finite3(current.rgb)) {
        atomicOr(status.invalid,128u);return;
    }
    if(supported) {
        atomicAdd(status.eligible,1u);age=1.0;
        vec3 normal=normalFrom(code);
        if(h.controls.z==0u)atomicAdd(status.resetPixels,1u);
        else {
            vec3 projected=projectPoint(worldPoint(vec2(pixel)+.5,z,h.view,h.intrinsics),h.previousView,h.previousIntrinsics);
            bool inBounds=projected.z>0.0&&!any(isnan(projected))&&!any(isinf(projected))&&
                all(greaterThanEqual(projected.xy,vec2(0.0)))&&all(lessThan(projected.xy,vec2(extent)));
            if(!inBounds)atomicAdd(status.rejectedProjection,1u);
            else {
                ivec2 q=ivec2(floor(projected.xy));
                uint qi=uint(q.y)*p.width+uint(q.x);
                HistoryPixel old=previous.pixels[qi];
                float oldZ=uintBitsToFloat(old.geometry.x);
                bool geometry=old.geometry.z==id&&old.geometry.w==1u&&old.incomingAge.a>=1.0&&
                    old.incomingAge.a<=float(h.controls.w)&&depthMatches(projected.z,oldZ)&&
                    dot(normal,normalFrom(old.geometry.y))>=.995;
                if(geometry) {
                    vec3 roundtrip=projectPoint(worldPoint(vec2(q)+.5,oldZ,h.previousView,h.previousIntrinsics),h.view,h.intrinsics);
                    geometry=roundtrip.z>0.0&&depthMatches(z,roundtrip.z)&&length(roundtrip.xy-(vec2(pixel)+.5))<=.75;
                }
                if(!geometry)atomicAdd(status.rejectedGeometry,1u);
                else {
                    vec3 low=current.rgb,high=current.rgb;uint support=0u;
                    for(int dy=-2;dy<=2;++dy)for(int dx=-2;dx<=2;++dx) {
                        ivec2 r=pixel+ivec2(dx,dy);
                        if(any(lessThan(r,ivec2(0)))||any(greaterThanEqual(r,extent)))continue;
                        uint ri=uint(r.y)*p.width+uint(r.x);
                        vec4 candidate=now.incoming[ri];
                        if(candidate.a!=1.0||texelFetch(instanceIds,r,0).r!=id||texelFetch(coverage,r,0).r==0u)continue;
                        if(!depthMatches(z,texelFetch(forwardDepth,r,0).r)||
                           dot(normal,normalFrom(uint(texelFetch(attributes,r,0).a)))<.995)continue;
                        low=min(low,candidate.rgb);high=max(high,candidate.rgb);++support;
                    }
                    if(support<3u)atomicAdd(status.rejectedSupport,1u);
                    else {
                        if(!finite3(old.incomingAge.rgb)){atomicOr(status.invalid,256u);return;}
                        vec3 bounded=clamp(old.incomingAge.rgb,low,high);
                        if(any(notEqual(bounded,old.incomingAge.rgb)))atomicAdd(status.clamped,1u);
                        age=min(old.incomingAge.a+1.0,float(h.controls.w));
                        // Bounded EMA after cap, not an independent sample count.
                        filtered=bounded*(1.0-1.0/age)+current.rgb*(1.0/age);
                        atomicAdd(status.accepted,1u);
                    }
                }
            }
        }
        atomicAdd(status.ageSum,uint(age));
    }
    nextHistory.pixels[index].incomingAge=vec4(filtered,age);
    nextHistory.pixels[index].geometry=uvec4(floatBitsToUint(z),code,id,supported?1u:0u);
    vec3 color=base.rgb;
    if(id!=0u&&texelFetch(coverage,pixel,0).r!=0u) {
        uint rhoCode=uint(base.a);
        vec3 rho=vec3(rhoCode&255u,(rhoCode>>8u)&255u,(rhoCode>>16u)&255u)*(1.0/255.0);
        color+=rho*filtered;
    }
    if(!finite3(color)){atomicOr(status.invalid,512u);return;}
    imageStore(resolvedLinear,pixel,vec4(color,1.0));
    vec3 mapped=residentDisplayLinear(color*p.exposure,float(p.mode));
    if(!finite3(mapped)){atomicOr(status.invalid,1024u);return;}
    mapped=clamp(mapped,0.0,1.0);
    mapped=mix(12.92*mapped,1.055*pow(mapped,vec3(1.0/2.4))-.055,greaterThan(mapped,vec3(.0031308)));
    imageStore(displayColor,pixel,vec4(mapped,1.0));
}
