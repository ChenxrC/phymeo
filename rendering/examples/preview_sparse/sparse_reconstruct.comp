#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=8,local_size_y=8) in;
layout(constant_id=69) const uint PR_SPATIAL_MEAN_ABI=1u;
layout(constant_id=80) const uint PR_PREVIEW_SPARSE_COMPUTE_ABI=1u;
layout(set=0,binding=0,rgba32f) readonly uniform image2D currentLinear;
layout(set=0,binding=1,rgba32f) writeonly uniform image2D meanLinear;
layout(set=0,binding=2,rgba8) writeonly uniform image2D displayColor;
layout(set=0,binding=3,std430) buffer Status {
    uint invalid; uint visible; uint anchors; uint reconstructed;
    uint fallback; uint nondiffuse; uint acceptedNeighbors; uint primaryProposals;
} status;
layout(set=0,binding=4) uniform sampler2D indirectGuide;
layout(set=0,binding=5) uniform sampler2D forwardDepth;
layout(set=0,binding=6) uniform usampler2D instanceIds;
layout(set=0,binding=7) uniform usampler2D coverage;
layout(push_constant) uniform Push { uint width,height,batch,mode; float exposure; } p;
#include "resident_display.glsl"
bool finiteRadiance(vec3 x) {return !any(isnan(x))&&!any(isinf(x))&&!any(lessThan(x,vec3(0.0)));}
vec3 rhoDecode(float value) {
    uint code=uint(round(value));
    return vec3(code&255u,(code>>8u)&255u,(code>>16u)&255u)*(1.0/255.0);
}
vec3 normalDecode(uint code) {
    vec2 v=vec2(code&1023u,(code>>10u)&1023u)*(2.0/1023.0)-vec2(1.0);
    vec3 n=vec3(v,1.0-abs(v.x)-abs(v.y));
    if(n.z<0.0)n.xy=(vec2(1.0)-abs(n.yx))*mix(vec2(-1.0),vec2(1.0),greaterThanEqual(n.xy,vec2(0.0)));
    return normalize(n);
}
void main() {
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy),extent=ivec2(p.width,p.height);
    if(any(greaterThanEqual(pixel,extent)))return;
    vec4 current=imageLoad(currentLinear,pixel);
    if(PR_SPATIAL_MEAN_ABI!=1u||PR_PREVIEW_SPARSE_COMPUTE_ABI!=1u||p.batch!=0u||!finiteRadiance(current.rgb)) {
        atomicOr(status.invalid,1u);return;
    }
    vec3 linear=current.rgb;
    uint id=texelFetch(instanceIds,pixel,0).r;
    if(id!=0u && texelFetch(coverage,pixel,0).r!=0u) {
        atomicAdd(status.visible,1u);
        if(isnan(current.a)||isinf(current.a)||current.a<0.0||current.a>16777215.0){atomicOr(status.invalid,2u);return;}
        vec3 rho=rhoDecode(current.a);
        if(any(greaterThan(rho,vec3(0.0)))) {
            vec4 own=texelFetch(indirectGuide,pixel,0);
            if(!finiteRadiance(own.rgb)||isnan(own.a)||isinf(own.a)||own.a<0.0||own.a>2097151.0){atomicOr(status.invalid,4u);return;}
            uint packed=uint(round(own.a));vec3 normal=normalDecode(packed);
            bool isAnchor=(packed&(1u<<20u))!=0u;
            vec3 incoming=own.rgb;
            if(isAnchor) {
                atomicAdd(status.anchors,1u);atomicAdd(status.primaryProposals,uint(PR_PREVIEW_PATHS));
            }
            // The broad variant also smooths traced anchors, preventing a raw
            // noisy lattice inside an otherwise filtered image. Tile1 remains
            // the unfiltered full-rate control for this exact estimator.
            if(!isAnchor || (PR_PREVIEW_NEIGHBORS==25 && PR_PREVIEW_TILE>1)) {
                float z=texelFetch(forwardDepth,pixel,0).r;
                if(isnan(z)||isinf(z)||z<=0.0){atomicOr(status.invalid,8u);return;}
                vec2 gridPosition=(vec2(pixel)-float(PR_PREVIEW_TILE/2))/float(PR_PREVIEW_TILE);
#if PR_PREVIEW_NEIGHBORS == 25
                ivec2 base=ivec2(floor(gridPosition+vec2(.5)))-ivec2(2);
                const int side=5;
#else
                ivec2 base=ivec2(floor(gridPosition));
                const int side=2;
#endif
                ivec2 lastTile=(extent-ivec2(1))/PR_PREVIEW_TILE;
                vec3 sum=vec3(0.0);float total=0.0;
#if PR_PREVIEW_RECONSTRUCTION_REVISION == 2
                // Unique tile indices, including the clipped final odd tile.
                ivec2 first=max(base,ivec2(0));
                ivec2 last=min(base+ivec2(side-1),lastTile);
                uint accepted=0u;
                for(int y=first.y;y<=last.y;++y)for(int x=first.x;x<=last.x;++x) {
                    ivec2 q=min(ivec2(x,y)*PR_PREVIEW_TILE+ivec2(PR_PREVIEW_TILE/2),extent-ivec2(1));
#else
                ivec2 visited[PR_PREVIEW_NEIGHBORS];int count=0;
                for(int y=0;y<side;++y)for(int x=0;x<side;++x) {
                    ivec2 q=min(clamp(base+ivec2(x,y),ivec2(0),lastTile)*PR_PREVIEW_TILE+ivec2(PR_PREVIEW_TILE/2),extent-ivec2(1));
                    bool duplicate=false;for(int k=0;k<count;++k)duplicate=duplicate||all(equal(q,visited[k]));
                    if(duplicate)continue;visited[count++]=q;
#endif
                    if(texelFetch(instanceIds,q,0).r!=id||texelFetch(coverage,q,0).r==0u)continue;
                    vec4 candidate=texelFetch(indirectGuide,q,0);
                    if(!finiteRadiance(candidate.rgb)||isnan(candidate.a)||isinf(candidate.a)||candidate.a<0.0||candidate.a>2097151.0){atomicOr(status.invalid,16u);continue;}
                    uint candidateCode=uint(round(candidate.a));
                    if((candidateCode&(1u<<20u))==0u)continue;
                    float qz=texelFetch(forwardDepth,q,0).r;
                    if(isnan(qz)||isinf(qz)||qz<=0.0){atomicOr(status.invalid,32u);continue;}
                    if(abs(z-qz)>.003*min(z,qz)||dot(normal,normalDecode(candidateCode))<.98)continue;
#if PR_PREVIEW_NEIGHBORS == 25
                    vec2 tileDistance=vec2(q-pixel)/float(PR_PREVIEW_TILE);
                    float weight=exp(-dot(tileDistance,tileDistance)/(2.0*1.5*1.5))*(1.0/32.0);
#else
                    float weight=(1.0/(1.0+dot(vec2(q-pixel),vec2(q-pixel))))*.25;
#endif
                    // Divide bounded weights first to avoid large-HDR intermediate overflow.
                    sum+=candidate.rgb*weight;total+=weight;
#if PR_PREVIEW_RECONSTRUCTION_REVISION == 2
                    ++accepted;
#else
                    atomicAdd(status.acceptedNeighbors,1u);
#endif
                }
#if PR_PREVIEW_RECONSTRUCTION_REVISION == 2
                if(accepted!=0u)atomicAdd(status.acceptedNeighbors,accepted);
#endif
                if(total>0.0){incoming=sum/total;if(!isAnchor)atomicAdd(status.reconstructed,1u);}
                else if(isAnchor)atomicOr(status.invalid,256u); // its own valid sample must survive
                else atomicAdd(status.fallback,1u); // current pixel SH, never a neighbour's material
            }
            linear+=rho*incoming; // chromatic receiver coefficient applied only here
        } else atomicAdd(status.nondiffuse,1u);
    }
    if(!finiteRadiance(linear)){atomicOr(status.invalid,64u);return;}
    imageStore(meanLinear,pixel,vec4(linear,1.0)); // reconstructed exposure, NOT a Monte Carlo mean
    vec3 mapped=residentDisplayLinear(linear*p.exposure,float(p.mode));
    if(!finiteRadiance(mapped)){atomicOr(status.invalid,128u);return;}
    vec3 color=clamp(mapped,0.0,1.0);
    color=mix(12.92*color,1.055*pow(color,vec3(1.0/2.4))-.055,greaterThan(color,vec3(.0031308)));
    imageStore(displayColor,pixel,vec4(color,1.0));
}
