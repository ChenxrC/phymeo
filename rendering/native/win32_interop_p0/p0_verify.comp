#version 450
layout(local_size_x=64) in;
layout(std430,set=0,binding=0) buffer Payload { uint words[]; } payload;
layout(std430,set=0,binding=1) buffer Audit {
    uint checked; uint mismatches; uint firstInput; uint lastInput;
} audit;
layout(push_constant) uniform Params { uint count; uint marker; } p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.count) return;
    uint actual = payload.words[i];
    atomicAdd(audit.checked, 1u);
    if (actual != p.marker) atomicAdd(audit.mismatches, 1u);
    if (i == 0u) audit.firstInput = actual;
    if (i == p.count-1u) audit.lastInput = actual;
    payload.words[i] = actual ^ 0xa5a55a5au ^ i;
}
