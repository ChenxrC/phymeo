#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=8,local_size_y=8) in;
layout(constant_id=67) const uint PR_PROGRESSIVE_MEAN_ABI=1u;
layout(set=0,binding=0,rgba32f) readonly uniform image2D currentLinear;
layout(set=0,binding=1,rgba32f) uniform image2D meanLinear;
layout(set=0,binding=2,rgba8) writeonly uniform image2D displayColor;
layout(set=0,binding=3,std430) buffer Status { uint invalid; } status;
layout(push_constant) uniform Push { uint width,height,batch,mode; float exposure; } p;
#include "resident_display.glsl"
void main() {
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
    if(pixel.x>=p.width||pixel.y>=p.height)return;
    vec3 value=imageLoad(currentLinear,pixel).rgb;
    vec3 previous=p.batch==0u?vec3(0.0):imageLoad(meanLinear,pixel).rgb;
    if(PR_PROGRESSIVE_MEAN_ABI!=1u||any(isnan(value))||any(isinf(value))||any(lessThan(value,vec3(0.0)))) {
        atomicOr(status.invalid,1u);return;
    }
    vec3 mean=p.batch==0u?value:previous+(value-previous)/float(p.batch+1u);
    imageStore(meanLinear,pixel,vec4(mean,1.0));
    vec3 color=clamp(residentDisplayLinear(mean*p.exposure,float(p.mode)),0.0,1.0);
    color=mix(12.92*color,1.055*pow(color,vec3(1.0/2.4))-.055,greaterThan(color,vec3(.0031308)));
    imageStore(displayColor,pixel,vec4(color,1.0));
}
