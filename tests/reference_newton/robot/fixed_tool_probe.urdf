<?xml version="1.0"?>
<robot name="wrist_probe">
  <link name="base"/>
  <link name="pedestal">
    <collision name="base_fiducial"><origin xyz="0.0625 0 0"/><geometry><sphere radius="0.015625"/></geometry></collision>
  </link>
  <link name="upper">
    <inertial><origin xyz="0.125 0 0" rpy="1.5707963267948966 0 0"/><mass value="2"/>
      <inertia ixx="0.0625" ixy="0.015625" ixz="0" iyy="0.078125" iyz="0" izz="0.09375"/></inertial>
  </link>
  <link name="elbow">
    <inertial><origin xyz="0.0625 0.03125 0" rpy="0 0 0.7853981633974483"/><mass value="1"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.025" iyz="0" izz="0.03"/></inertial>
    <collision name="housing"><origin xyz="-0.05 0.05 0"/><geometry><box size="0.04 0.035 0.03"/></geometry></collision>
  </link>
  <link name="slide">
    <inertial><origin xyz="0.03125 0 0"/><mass value="0.5"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.006"/></inertial>
  </link>
  <link name="collet">
    <inertial><origin xyz="0.03125 0 0"/><mass value="0.25"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.00125" iyz="0" izz="0.0015"/></inertial>
    <collision name="housing"><origin xyz="0 0.04 0"/><geometry><box size="0.025 0.02 0.015"/></geometry></collision>
  </link>
  <link name="probe">
    <inertial><origin xyz="0.015625 0.0078125 0.015625" rpy="0.45 -0.25 0.38"/><mass value="0.25"/>
      <inertia ixx="0.0015" ixy="0.0002" ixz="0" iyy="0.0018" iyz="0.0001" izz="0.002"/></inertial>
    <collision name="tip"><origin xyz="0.03125 0 0"/><geometry><sphere radius="0.025"/></geometry></collision>
  </link>
  <joint name="mount" type="fixed"><parent link="base"/><child link="pedestal"/><origin xyz="0.25 -0.125 0.25" rpy="0 0 1.5707963267948966"/></joint>
  <joint name="shoulder" type="revolute"><parent link="pedestal"/><child link="upper"/><origin xyz="0.125 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-2" upper="2" effort="20" velocity="3"/></joint>
  <joint name="bracket" type="fixed"><parent link="upper"/><child link="elbow"/><origin xyz="0.25 0 0" rpy="0 0 1.5707963267948966"/></joint>
  <joint name="extension" type="prismatic"><parent link="elbow"/><child link="slide"/><origin xyz="0.125 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-0.06" upper="0.12" effort="12" velocity="2"/></joint>
  <joint name="mount_collet" type="fixed"><parent link="slide"/><child link="collet"/><origin xyz="0.125 -0.0625 0" rpy="0 0 1.5707963267948966"/></joint>
  <joint name="install_tip" type="fixed"><parent link="collet"/><child link="probe"/><origin xyz="0.0625 0 0.03125" rpy="0 1.5707963267948966 0"/></joint>
</robot>
