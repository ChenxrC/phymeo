<?xml version="1.0"?>
<mujoco model="joint_interval_arm">
  <compiler angle="radian" inertiafromgeom="false"/>
  <worldbody><body name="base">
    <geom name="north" type="sphere" size="0.0625" pos="0 0.75 0"/>
    <geom name="south" type="sphere" size="0.0625" pos="0 -0.75 0"/>
    <body name="carriage">
      <joint name="advance" type="slide" axis="1 0 0" range="-4 4"/>
      <inertial pos="0 0 0" mass="1" diaginertia="0.125 0.125 0.125"/>
      <geom name="carriage_tag" type="box" size="0.05 0.1 0.15" pos="-3 0 0"/>
      <body name="elevator">
        <joint name="diagonal" type="slide" axis="0 0.6 0.8" range="-4 4"/>
        <inertial pos="0 0 0" mass="1" diaginertia="0.125 0.125 0.125"/>
        <geom name="lift_tag" type="sphere" size="0.0625" pos="0 0 3"/>
        <body name="rotor">
          <joint name="spin" type="hinge" axis="0 0 1" range="-20 20"/>
          <inertial pos="0 0 0" mass="1" diaginertia="0.125 0.125 0.125"/>
          <geom name="pointer" type="capsule" size="0.0625" fromto="0.5 0 0 1 0 0"/>
          <body name="finger">
            <joint name="extend" type="slide" axis="1 0 0" range="-2 2"/>
            <inertial pos="0 0 0" mass="1" diaginertia="0.125 0.125 0.125"/>
            <geom name="finger_tip" type="sphere" size="0.0625" pos="3 0 0"/>
          </body>
          <body name="wrist">
            <joint name="bend" type="hinge" axis="1 0 0" range="-20 20"/>
            <inertial pos="0 0 0" mass="1" diaginertia="0.125 0.125 0.125"/>
            <geom name="wrist_tag" type="sphere" size="0.0625" pos="0 3 0"/>
          </body>
        </body>
      </body>
    </body>
    <body name="independent" pos="4 0 0">
      <joint name="independent_spin" type="hinge" axis="0 1 0" range="-20 20"/>
      <inertial pos="0 0 0" mass="1" diaginertia="0.125 0.125 0.125"/>
      <geom name="other" type="ellipsoid" size="0.25 0.125 0.0625" pos="0.3 0.2 0.1" euler="0.15 -0.2 0.3"/>
    </body>
  </body></worldbody>
</mujoco>
