<?xml version="1.0"?>
<robot name="countermoving_jaws">
  <link name="base"/>
  <link name="carriage"><inertial><mass value="1"/><inertia ixx="0.008" iyy="0.009" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <link name="left">
    <inertial><origin xyz="0 0.004 0.006"/><mass value="0.2"/><inertia ixx="0.0005" iyy="0.0006" izz="0.00075" ixy="0" ixz="0" iyz="0"/></inertial>
    <collision name="left_rubber"><geometry><box size="0.006 0.024 0.018"/></geometry></collision>
  </link>
  <link name="right">
    <inertial><origin xyz="0 -0.003 0.004"/><mass value="0.3"/><inertia ixx="0.0008" iyy="0.0009" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
    <collision name="right_rubber"><geometry><box size="0.006 0.024 0.018"/></geometry></collision>
  </link>
  <joint name="lift" type="prismatic"><parent link="base"/><child link="carriage"/><origin xyz="0.25 -0.125 0.25"/><axis xyz="0 0 1"/>
    <limit lower="-0.01" upper="0.09" effort="40" velocity="0.45"/></joint>
  <joint name="screw" type="prismatic"><parent link="carriage"/><child link="left"/><origin xyz="-0.035 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-0.007" upper="0.027" effort="9" velocity="0.30"/></joint>
  <joint name="idler" type="prismatic"><parent link="carriage"/><child link="right"/><origin xyz="0.031 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-0.018" upper="0.009" effort="0.5" velocity="0.20"/><mimic joint="screw" multiplier="-1" offset="0.004"/></joint>
</robot>
