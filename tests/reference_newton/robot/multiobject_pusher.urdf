<?xml version="1.0"?>
<!-- Self-authored analytic fixture: 2 kg on one x slider, one finite tool sphere. -->
<robot name="multiobject_pusher">
  <link name="base"/>
  <link name="pusher">
    <inertial>
      <mass value="2"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <collision name="round_tool"><geometry><sphere radius="0.0625"/></geometry></collision>
  </link>
  <joint name="slide" type="prismatic">
    <parent link="base"/><child link="pusher"/>
    <origin xyz="0 0 0.25"/><axis xyz="1 0 0"/>
    <limit lower="-0.1" upper="0.1" effort="20" velocity="1"/>
  </joint>
</robot>