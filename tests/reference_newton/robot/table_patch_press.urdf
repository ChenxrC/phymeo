<?xml version="1.0"?>
<robot name="table_patch_press">
  <link name="base"/>
  <link name="carriage">
    <inertial><mass value="0.5"/><inertia ixx="0.0003255208333333333" iyy="0.0003255208333333333" izz="0.0003255208333333333" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <link name="shoe">
    <inertial><mass value="1.5"/><inertia ixx="0.00244140625" iyy="0.00830078125" izz="0.009765625" ixy="0" ixz="0" iyz="0"/></inertial>
    <collision name="sole"><geometry><box size="0.25 0.125 0.0625"/></geometry></collision>
  </link>
  <joint name="lift" type="prismatic">
    <parent link="base"/><child link="carriage"/><origin xyz="0.0625 0.015625 0.0302734375"/>
    <axis xyz="0 0 1"/><limit lower="-0.02" upper="0.2" effort="20" velocity="2"/>
  </joint>
  <joint name="twist" type="revolute">
    <parent link="carriage"/><child link="shoe"/><axis xyz="0 0 1"/>
    <limit lower="-2" upper="2" effort="2" velocity="3"/>
  </joint>
</robot>
